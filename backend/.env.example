# Copia este archivo a ".env" y completa los valores reales.
# Nunca subas el archivo ".env" real al repositorio.

# --- Django ---
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-generada
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Solo al publicar en internet (ver DESPLIEGUE.md) ---
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=usuario.pythonanywhere.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://usuario.pythonanywhere.com
# DJANGO_SECURE=True          # cookies seguras + HSTS
# DJANGO_SSL_REDIRECT=False   # True solo si el hosting no fuerza HTTPS
# DJANGO_SERVIR_MEDIA=False   # True si no hay forma de mapear /media/

# --- Geocodificacion (nominatim | google | mapbox) ---
GEOCODING_PROVIDER=nominatim
GEOCODING_API_KEY=

# --- Ruteo por red vial real (OSRM) ---
# Por defecto usa el servidor demo publico de OSRM (gratis, sin API key,
# no apto para uso intensivo). Apunta OSRM_URL a un servidor propio para
# produccion, u OSRM_HABILITADO=False para usar distancia en linea recta.
OSRM_URL=https://router.project-osrm.org
OSRM_HABILITADO=True

# --- Correo (opcional) ---
# Sin estas dos variables, los correos se imprimen en la consola y no
# salen de verdad. Con una cuenta de Gmail + contrasena de aplicacion,
# el envio real por SMTP se activa solo, sin tocar codigo.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
