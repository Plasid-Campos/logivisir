# Copia este archivo a ".env" y completa los valores reales.
# Nunca subas el archivo ".env" real al repositorio.

DJANGO_SECRET_KEY=cambia-esto-por-una-clave-generada
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Proveedor de geocodificacion (nominatim | google | mapbox)
GEOCODING_PROVIDER=nominatim
GEOCODING_API_KEY=
